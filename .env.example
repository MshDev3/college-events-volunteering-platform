# ===============================================================
# Copy to .env and adjust. The defaults below are SAFE FOR PRODUCTION.
# For local development see "Local development" in README.md
# (APP_ENV=local, APP_DEBUG=true, MAIL_DRIVER=log, DEMO_* passwords).
# ===============================================================

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_NAME="TVTC Campus"
# production | local
#   local enables the development mail viewer (/_dev/mail, admin + localhost only), the
#   demo data script, `migrate --fresh` and the smoke tests. Never use "local" on a server.
APP_ENV=production
# Show exception details in the browser (only honoured when APP_ENV=local).
APP_DEBUG=false
# Public base URL, no trailing slash. Used for links in emails (never the Host header).
# If it starts with https://, session and remember-me cookies are always marked Secure.
APP_URL=http://localhost/<project folder>
APP_TIMEZONE=Asia/Riyadh
# ar | en
APP_DEFAULT_LOCALE=ar

# Reverse proxy / load balancer terminating HTTPS in front of PHP.
# Comma-separated IP addresses of proxies you control. ONLY requests whose REMOTE_ADDR is
# listed here may use X-Forwarded-Proto / X-Forwarded-For. Leave empty when PHP is reached directly.
TRUSTED_PROXIES=

# ---------------------------------------------------------------
# Database (MariaDB / MySQL)
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tvtc_portal
# Runtime account: SELECT, INSERT, UPDATE, DELETE on DB_DATABASE only.
# Create it with database/setup/create_app_user.sql. "root" is refused unless APP_ENV=local.
DB_USERNAME=tvtc_app
DB_PASSWORD=
# Schema account for `php bin/console migrate` only (CREATE, ALTER, DROP, INDEX, REFERENCES + DML).
# Leave empty to migrate with DB_USERNAME (which then needs those privileges itself).
# Ideally set these only in the shell that runs migrations, not in the web server's .env.
DB_MIGRATE_USERNAME=
DB_MIGRATE_PASSWORD=
# Legacy database the importer reads from (read-only)
LEGACY_DB_DATABASE=project
# Separate database for the PHPUnit integration tests (dropped and re-created by the tests).
# Development machines only; must differ from DB_DATABASE.
DB_TEST_DATABASE=

# ---------------------------------------------------------------
# Sessions & authentication
# ---------------------------------------------------------------
SESSION_NAME=tvtc_session
# Idle timeout for normal (not remembered) sessions, minutes
SESSION_IDLE_MINUTES=120
# Absolute lifetime of a normal session, minutes
SESSION_ABSOLUTE_MINUTES=720
REMEMBER_ME_DAYS=30
PASSWORD_RESET_MINUTES=60
# Lifetime of the link that confirms a new login email, minutes
EMAIL_CHANGE_MINUTES=60

# ---------------------------------------------------------------
# Mail
# ---------------------------------------------------------------
# smtp = send through the SMTP server below (production)
# log  = write emails to storage/mail instead of sending (local development only;
#        readable at /_dev/mail by a logged-in admin on localhost when APP_ENV=local)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="TVTC Campus"
# Password-reset emails are queued so response times never reveal whether an address is registered.
#   after_response = sent right after the page is delivered (no setup needed)
#   cron           = sent only by `php bin/console mail:work`; schedule it every minute
MAIL_QUEUE=after_response

# ---------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------
UPLOAD_MAX_MB=5

# ---------------------------------------------------------------
# Demo data — LOCAL DEVELOPMENT ONLY
# Read only by `php database/demo/seed.php` (refuses to run unless APP_ENV=local) and the smoke tests.
# Passwords must be strong (12+ characters with upper and lower case, a digit and a symbol);
# leave them empty to have the script generate random ones and print them once.
# ---------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@college.test
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=student@college.test
DEMO_STUDENT_PASSWORD=
