{
    "name": "tvtc/college-platform",
    "description": "Technical College platform: events, volunteering and college services (Arabic/English).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.6",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": ["@php bin/console assets:publish"],
        "post-update-cmd": ["@php bin/console assets:publish"],
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
