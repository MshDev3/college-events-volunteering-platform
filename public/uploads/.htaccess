# User-uploaded images only. Never execute anything from here.
# (Uploads are stored with random names and an extension derived from the verified MIME type:
#  .jpg / .png / .webp. These rules are defence in depth.)
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht .cgi .pl .py .sh
RemoveType .php .phtml .phar

<IfModule php_module>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|svg|html?|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
</IfModule>
